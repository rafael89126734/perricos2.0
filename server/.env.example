# Copia como .env para desarrollo local; no subas .env al repositorio.
PORT=4000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-local-postgres-password
PGDATABASE=perricos
# Para Postgres remoto, define DATABASE_URL y elimina/ignora PG* locales.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PGSSLMODE=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=12h
ADMIN_EMAIL=admin@perricos.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NOMBRE=Administrador

# Para hosting con almacenamiento persistente de imágenes (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=perricos-images

